@page
@model LogoutModel

@{
    ViewData["Title"] = "Log out";
}

<div class="animate-fade-up" style="max-width:400px;margin:4rem auto;text-align:center;">
    <div style="font-size:3rem;margin-bottom:1rem;"></div>
    <h1>Signed Out</h1>
    <p style="color:var(--gray-600);margin-bottom:2rem;">
        You have been successfully signed out of the Student Management System.
    </p>
    <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary"> Sign Back In</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary"> Home</a>
    </div>
</div>
